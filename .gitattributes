# Markdown treats two trailing spaces as a hard line break, so trailing
# whitespace in these files is syntax rather than an error. Disabling the
# check here keeps `git diff --check` useful for what does matter, such as
# leftover conflict markers.
*.md whitespace=-trailing-space
*.mdc whitespace=-trailing-space
/.gitattributes text eol=lf

# Route shim generator emits LF; keep working-tree text LF even with core.autocrlf.
dist/route-shims/** text eol=lf

# Skill package text must stay LF so invalid-UTF-8 fallback cannot diverge
# across Windows autocrlf vs Ubuntu LF checkouts (manifest sha256 blind spot).
.cursor/skills/**/*.js text eol=lf
.cursor/skills/**/*.md text eol=lf
.cursor/skills/**/*.json text eol=lf
.cursor/skills/**/*.yaml text eol=lf
.cursor/skills/**/*.yml text eol=lf
.agents/skills/**/*.js text eol=lf
.agents/skills/**/*.md text eol=lf
.agents/skills/**/*.json text eol=lf
.agents/skills/**/*.yaml text eol=lf
.agents/skills/**/*.yml text eol=lf
skills/**/*.js text eol=lf
skills/**/*.md text eol=lf
skills/**/*.json text eol=lf
skills/**/*.yaml text eol=lf
skills/**/*.yml text eol=lf

# Content-addressed probe inputs and published evidence retain exact LF bytes.
probes/generated/** text eol=lf
probes/transcripts/2026-08-15/** text eol=lf
probes/profile-projection-* text eol=lf
probes/run-profile-projection-*.js text eol=lf
probes/verify-profile-projection-evidence.js text eol=lf

# Stderr captures are immutable byte evidence, not source files.
probes/transcripts/**/*.stderr.log binary
