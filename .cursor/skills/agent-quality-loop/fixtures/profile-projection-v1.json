  },
  "cases": [
    {
      "id": "PP01",
      "title": "active project entry is selected",
      "entry_uses": [{ "entry": "project_detail", "selected": true }],
      "expected": { "valid": true }
    },
    {
      "id": "PP02",
      "title": "candidate cannot be selected",
      "entry_uses": [{ "entry": "candidate_density", "selected": true }],
      "expected": { "valid": false, "error_contains": "status must be active when selected" }
    },
    {
      "id": "PP03",
      "title": "archived entry cannot be selected",
      "entry_uses": [{ "entry": "archived_brief", "selected": true }],
      "expected": { "valid": false, "error_contains": "status must be active when selected" }
    },
    {
      "id": "PP04",
      "title": "legacy entry with missing metadata cannot be selected",
      "entry_uses": [{
        "entry": "legacy_freeform",
        "selected": true,
        "legacy": true,
        "omit_fields": ["id", "scope", "source"]
      }],
      "expected": { "valid": false, "error_contains": "id is required for projectable entries" }
    },
    {
      "id": "PP05",
      "title": "current-turn instruction removes a conflicting entry",
      "entry_uses": [{
        "entry": "project_concise",
        "selected": false,
        "semantic": { "overridden_by_current_turn": true },
        "skip_reason": "Current turn explicitly requests a complete expanded analysis."
      }],
      "expected": { "valid": true }
    },
    {
      "id": "PP06",
      "title": "project scope wins over a conflicting user-global default",
      "enforce_priority": true,
      "entry_uses": [
        { "entry": "project_concise", "selected": true },
        { "entry": "user_detail", "selected": false, "skip_reason": "Lower-priority user-global default conflicts with the project-scoped entry." }
      ],
      "expected": { "valid": true }
    },
    {
      "id": "PP07",
      "title": "mismatched task class is skipped",
      "entry_uses": [{
        "entry": "task_code",
        "selected": false,
        "semantic": { "scope_matches": false },
        "skip_reason": "Current task is product architecture, not executable code."
      }],
      "expected": { "valid": true }
    },
    {
      "id": "PP08",
      "title": "more than two profile entries is rejected",
      "entry_uses": [
        { "entry": "project_detail", "selected": true },
        { "entry": "project_second", "selected": true },
        { "entry": "project_third", "selected": true }
      ],
      "expected": { "valid": false, "error_contains": "profile selection max is 2" }
    },
    {
      "id": "PP09",
      "title": "the same entry cannot be injected twice",
      "entry_uses": [
        { "entry": "project_detail", "selected": true },
        { "entry": "project_detail", "selected": true }
      ],
      "expected": { "valid": false, "error_contains": "selected profile entry ids must be unique" }
    },
    {
      "id": "PP10",
      "title": "selected entry requires an exact content hash",
      "entry_uses": [{ "entry": "project_detail", "selected": true }],
      "injected_ref_overrides": { "0": { "content_sha256": "" } },
      "expected": { "valid": false, "error_contains": "content_sha256 is invalid" }
    },
    {
      "id": "PP11",
      "title": "profile cannot raise action authority",
      "entry_uses": [{ "entry": "project_detail", "selected": true }],
      "effect_overrides": { "action_authority_after": "release" },
      "expected": { "valid": false, "error_contains": "profile must not change action_authority" }
    },
    {
      "id": "PP12",
      "title": "profile cannot lower the evidence floor",
      "entry_uses": [{ "entry": "quality_bar", "selected": true }],
      "effect_overrides": { "evidence_floor_after": "none" },
      "expected": { "valid": false, "error_contains": "profile must not lower or replace the evidence floor" }
    },
    {
      "id": "PP13",
      "title": "unconfirmed route alias cannot fire",
      "entry_uses": [{
        "entry": "route_accept",
        "selected": true,
        "semantic": { "explicitly_confirmed": false }
      }],
      "expected": { "valid": false, "error_contains": "confirm-only lane selected without explicit confirmation" }
    },
    {
      "id": "PP14",
      "title": "phrase in a quoted title is not an operational match",
      "entry_uses": [{
        "entry": "phrase_accept",
        "selected": false,
        "semantic": { "operational_match": false },
        "skip_reason": "The phrase appears only inside a document title."
      }],
      "expected": { "valid": true }
    },
    {
      "id": "PP15",
      "title": "Fresh Mode selects no profile entries",
      "fresh_mode": true,
      "entry_uses": [{ "entry": "project_detail", "selected": false, "skip_reason": "Fresh Mode skips stored profile defaults." }],
      "expected": { "valid": true }
    },
    {
      "id": "PP16",
      "title": "Fresh Mode must preserve technical lessons",
      "fresh_mode": true,
      "entry_uses": [{ "entry": "project_detail", "selected": false, "skip_reason": "Fresh Mode skips stored profile defaults." }],
      "effect_overrides": { "preserved_non_profile_context": { "technical_lessons": false } },
      "expected": { "valid": false, "error_contains": "must preserve non-profile context and trust boundaries" }
    },
    {
      "id": "PP17",
      "title": "Fresh Mode must not write the profile",
      "fresh_mode": true,
      "entry_uses": [{ "entry": "project_detail", "selected": false, "skip_reason": "Fresh Mode skips stored profile defaults." }],
      "effect_overrides": { "profile_written": true },
      "expected": { "valid": false, "error_contains": "must not create or rewrite a profile object" }
    },
    {
      "id": "PP18",
      "title": "temporary override must not permanently revise active state",
      "entry_uses": [{
        "entry": "project_concise",
        "selected": false,
        "semantic": { "overridden_by_current_turn": true },
        "skip_reason": "Current turn explicitly requests expanded output."
      }],
      "effect_overrides": { "active_entry_rewritten": true },
      "expected": { "valid": false, "error_contains": "temporary override must not rewrite an active profile entry" }
    },
    {
      "id": "PP19",
      "title": "Collaboration Brief cannot own an independent contract id",
      "entry_uses": [{ "entry": "project_detail", "selected": true }],
      "effect_overrides": { "collaboration_brief": { "contract_id": "brief-1" } },
      "expected": { "valid": false, "error_contains": "Collaboration Brief must have no independent id, phase, or persistence" }
    },
    {
      "id": "PP20",
      "title": "ordinary output must not expose internal projection terms",
      "entry_uses": [{ "entry": "project_detail", "selected": true }],
      "effect_overrides": { "user_visible_text": "Profile Projection applied." },
      "expected": { "valid": false, "error_contains": "ordinary output must not expose Profile Projection" }
    },
    {
      "id": "PP21",
      "title": "measured no-profile result uses an empty injected_refs array",
      "entry_uses": [],
      "measurement_status": "measured",
      "expected": { "valid": true }
    },
    {
      "id": "PP22",
      "title": "unmeasured injection remains unknown rather than empty",
      "entry_uses": [],
      "measurement_status": "unknown",
      "expected": { "valid": true }
    },
    {
      "id": "PP23",
      "title": "Guided dependency preference may yield to stronger professional evidence",
      "entry_uses": [{ "entry": "dependency_preference", "selected": true }],
      "effect_overrides": {
        "guided_deviation": true,
        "guided_deviation_reason": "A mature dependency provides materially safer parsing than a local implementation for this task."
      },
      "expected": { "valid": true }
    },
    {
      "id": "PP24",
      "title": "authority-shaped preference is stopped by the firewall",
      "entry_uses": [{
        "entry": "push_without_permission",
        "selected": true,
        "semantic": { "firewall_safe": false }
      }],
      "expected": { "valid": false, "error_contains": "selected despite authority firewall" }
    },
    {
      "id": "PP25",
      "title": "selected entries cannot hide behind unknown measurement",
      "entry_uses": [{ "entry": "project_detail", "selected": true }],
      "measurement_status": "unknown",
      "expected": { "valid": false, "error_contains": "selected entries cannot have unknown injection measurement" }
    },
    {
      "id": "PP26",
      "title": "clear tasks gain no profile questionnaire",
      "entry_uses": [{ "entry": "project_detail", "selected": true }],
      "task_clear": true,
      "effect_overrides": { "user_visible_questions_added": 1 },
      "expected": { "valid": false, "error_contains": "clear tasks must add zero profile questions" }
    },
    {
      "id": "PP27",
      "title": "entry ids are unique even when a duplicate is skipped",
      "entry_uses": [
        { "entry": "project_detail", "selected": true },
        { "entry": "project_detail", "selected": false, "skip_reason": "Duplicate catalog entry must not be retained." }
      ],
      "expected": { "valid": false, "error_contains": "profile entry ids must be unique across all entries" }
    },
    {
      "id": "PP28",
      "title": "injected ref reason must state a concrete match or effect",
      "entry_uses": [{ "entry": "project_detail", "selected": true }],
      "injected_ref_overrides": { "0": { "reason": "x" } },
      "expected": { "valid": false, "error_contains": "reason must name the match and effect" }
    },
    {
      "id": "PP29",
      "title": "non-ASCII priority ties use deterministic code-point order",
      "enforce_priority": true,
      "entry_uses": [
        { "entry": "tie_ascii_z", "selected": true },
        { "entry": "tie_non_ascii", "selected": false, "skip_reason": "Code-point ordering selects tie-z before tie-ä." }
      ],
      "expected": { "valid": true }
    }
  ]
}
