{
  "schema_version": "profile-projection-fixtures/v1",
  "fixture_version": "profile-projection-v1-fixtures/1",
  "defaults": {
    "measurement_status": "measured",
    "semantic": {
      "scope_matches": true,
      "applies_when_matches": true,
      "overridden_by_current_turn": false,
      "firewall_safe": true,
      "stale": false,
      "operational_match": true,
      "explicitly_confirmed": true,
      "specificity": 1
    },
    "effect": {
      "action_authority_before": "local_write",
      "action_authority_after": "local_write",
      "assurance_before": "standard",
      "assurance_after": "standard",
      "evidence_floor_before": "current contract evidence and acceptance floor",
      "evidence_floor_after": "current contract evidence and acceptance floor",
      "fixed_solution_steps_added": [],
      "collaboration_brief": {
        "contract_id": null,
        "phase": null,
        "persisted": false
      },
      "preserved_non_profile_context": {
        "current_turn": true,
        "project_facts": true,
        "project_rules": true,
        "project_context": true,
        "technical_lessons": true,
        "authority": true,
        "evidence": true,
        "acceptance": true,
        "release": true
      },
      "profile_written": false,
      "active_entry_rewritten": false,
      "profile_write_authorized": false,
      "last_fired_updates": [],
      "user_visible_questions_added": 0,
      "user_visible_text": "The result follows the current request and project evidence.",
      "guided_deviation": false,
      "guided_deviation_reason": ""
    }
  },
  "entries": {
