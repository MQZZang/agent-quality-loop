{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node integrations/cursor-hooks/aql-authority-gate.js",
        "matcher": "Write|Delete|EditNotebook|StrReplace|Shell",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node integrations/cursor-hooks/aql-authority-gate.js",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node integrations/cursor-hooks/aql-stop-gate.js",
        "loop_limit": 1,
        "timeout": 15
      }
    ]
  }
}
